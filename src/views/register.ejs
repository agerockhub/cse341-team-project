<%- include('./partials/header') %>
    <article class="booking-page">
        <div class="route-header">
            <div class="route-header-content">
                <h1 class="route-name">
                    <%= title %>
                </h1>
                <p class="route-description">Create a Kizuna Rail account.</p>
            </div>
        </div>

        <% if (error) { %>
            <p class="trains-state trains-error">
                <%= error %>
            </p>
            <% } %>

                <form class="booking-form" method="POST" action="/register">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="displayName" class="form-label">Display Name</label>
                            <input type="text" id="displayName" name="displayName" class="form-input"
                                value="<%= values.displayName || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" id="username" name="username" class="form-input"
                                value="<%= values.username || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" id="email" name="email" class="form-input"
                                value="<%= values.email || '' %>" required>
                        </div>
                        <div class="form-group">
                            <label for="password" class="form-label">Password (at least 8 characters)</label>
                            <input type="password" id="password" name="password" class="form-input" minlength="8"
                                required>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Register</button>
                        <a href="/login" class="btn btn-secondary">I already have an account</a>
                    </div>
                </form>
    </article>
    <%- include('./partials/footer') %>