<%- include('../partials/header') %>
    <h1>
        <%= title %>
    </h1>

    <form id="filters" role="search">
        <label for="trip-search">Search:</label>
        <input type="search" id="trip-search" maxlength="100" placeholder="Name or description">

        <label for="trip-region-filter">Region:</label>
        <select id="trip-region-filter">
            <option value="">All Regions</option>
            <% regions.forEach((region)=> { %>
                <option value="<%= region %>">
                    <%= region.charAt(0).toUpperCase() + region.slice(1) %>
                </option>
                <% }); %>
        </select>

        <label for="trip-season-filter">Season:</label>
        <select id="trip-season-filter">
            <option value="">Any Season</option>
            <% seasons.forEach((season)=> { %>
                <option value="<%= season %>">
                    <%= season.charAt(0).toUpperCase() + season.slice(1) %>
                </option>
                <% }); %>
        </select>

        <button type="submit" class="btn btn-primary">Search</button>
        <button type="button" class="btn btn-secondary" id="trip-clear">Clear</button>
    </form>

    <div class="trains-state" id="trips-loading">Loading trips...</div>
    <div class="trains-state trains-error" id="trips-error" hidden></div>

    <div class="routes-grid" id="trips-list"></div>

    <nav class="trips-pagination" id="trips-pagination" aria-label="Trip pages" hidden>
        <button type="button" class="btn btn-secondary" id="trips-prev">Previous</button>
        <span id="trips-page-info" aria-live="polite"></span>
        <button type="button" class="btn btn-secondary" id="trips-next">Next</button>
    </nav>

    <template id="trip-card-template">
        <div class="route-card">
            <div class="route-header">
                <h2 class="route-name" data-field="name"></h2>
                <span class="route-region" data-field="region"></span>
            </div>

            <div class="station-info">
                <div class="station">
                    <div class="station-type">From:</div>
                    <div class="station-name" data-field="start"></div>
                </div>
                <div class="route-arrow">&#8594;</div>
                <div class="station">
                    <div class="station-type">To:</div>
                    <div class="station-name" data-field="end"></div>
                </div>
            </div>

            <div class="route-details">
                <div class="detail-item">
                    <span class="detail-icon">&#128337;</span>
                    <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
                </div>
                <div class="detail-item">
                    <span class="detail-icon">&#128205;</span>
                    <span><span class="detail-label">Distance:</span> <span data-field="distance"></span></span>
                </div>
                <div class="detail-item">
                    <span class="season-badge" data-field="season"></span>
                </div>
            </div>

            <div class="route-description" data-field="description"></div>

            <div class="highlights">
                <div class="highlights-list" data-field="highlights"></div>
            </div>

            <div class="route-actions">
                <a href="#" class="view-details-btn" data-field="link">View Details &amp; Book &#8594;</a>
            </div>
        </div>
    </template>

    <script src="/js/trips.js"></script>

    <%- include('../partials/footer') %>