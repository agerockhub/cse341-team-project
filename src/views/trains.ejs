<%- include('./partials/header') %>

<section class="trains-hero">
    <h1>Learn about our Trains</h1>
    <p>
        Explore the physical trains that power scenic trips across the Kizuna Rail network.
    </p>
</section>

<section class="trains-catalog">

    <!-- Search and Filter Controls -->
    <section class="trains-search-panel" aria-label="Search and filter trains">

        <form id="trains-search-form" class="trains-search-form">

            <!-- Keyword Search -->
            <div class="trains-search-field">
                <label for="trains-search-input">Search trains</label>

                <input
                    type="search"
                    id="trains-search-input"
                    name="q"
                    placeholder="Search train name, operator, description..."
                    autocomplete="off"
                >
            </div>

            <!-- Train Type Filter -->
            <div class="trains-search-field">
                <label for="trains-type-filter">Train Type</label>

                <select id="trains-type-filter" name="type">
                    <option value="">All Train Types</option>
                    <option value="Limited Express">Limited Express</option>
                    <option value="Diesel Limited Express">Diesel Limited Express</option>
                    <option value="Steam Excursion">Steam Excursion</option>
                </select>
            </div>

            <!-- Power Source Filter -->
            <div class="trains-search-field">
                <label for="trains-power-filter">Power Source</label>

                <select id="trains-power-filter" name="powerSource">
                    <option value="">All Power Sources</option>
                    <option value="Electric">Electric</option>
                    <option value="Diesel">Diesel</option>
                    <option value="Steam">Steam</option>
                </select>
            </div>

            <!-- Search Actions -->
            <div class="trains-search-actions">
                <button type="submit" id="trains-search-btn" class="trains-search-btn">
                    Search
                </button>

                <button type="button" id="trains-clear-btn" class="trains-clear-btn">
                    Clear Filters
                </button>
            </div>

        </form>
    </section>

    <!-- Loading State -->
    <div class="trains-state" id="trains-loading">
        Loading trains...
    </div>

    <!-- Error State -->
    <div class="trains-state trains-error" id="trains-error" hidden></div>

    <!-- Empty Results State -->
    <div class="trains-state trains-empty" id="trains-empty" hidden>
        <h2>No trains found</h2>
        <p>
            We couldn't find any trains matching your search or filters.
            Try changing your search criteria.
        </p>
    </div>

    <!-- Train Cards -->
    <div class="trains-grid" id="trains-list"></div>

    <!-- Pagination Controls -->
    <nav
        class="trains-pagination"
        id="trains-pagination"
        aria-label="Train pagination"
        hidden
    >
        <button
            type="button"
            id="trains-prev"
            class="pagination-btn"
            disabled
        >
            &larr; Previous
        </button>

        <span id="trains-page-info" class="pagination-info">
            Page 1 of 1
        </span>

        <button
            type="button"
            id="trains-next"
            class="pagination-btn"
            disabled
        >
            Next &rarr;
        </button>
    </nav>

    <!-- Train Card Template -->
    <template id="train-card-template">
        <article class="train-card">

            <div class="train-image-wrap">
                <img data-field="image" loading="lazy" decoding="async">
            </div>

            <header class="train-card-header">
                <h2 data-field="name"></h2>
                <span class="train-operator" data-field="operator"></span>
            </header>

            <p class="train-description" data-field="description"></p>

            <dl class="train-specs">
                <div class="spec-item">
                    <dt>Type</dt>
                    <dd data-field="type"></dd>
                </div>

                <div class="spec-item">
                    <dt>Top Speed</dt>
                    <dd data-field="speed"></dd>
                </div>

                <div class="spec-item">
                    <dt>Capacity</dt>
                    <dd data-field="seats"></dd>
                </div>

                <div class="spec-item">
                    <dt>Power</dt>
                    <dd data-field="power"></dd>
                </div>
            </dl>

            <p class="train-best-for">
                <strong>Best For:</strong>
                <span data-field="best-for"></span>
            </p>

        </article>
    </template>

</section>

<%- include('./partials/footer') %>
